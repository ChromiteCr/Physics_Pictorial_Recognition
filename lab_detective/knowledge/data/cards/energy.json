  "apparatus": [
    "轨道（一端可垫高）",
    "垫块",
    "小车（带遮光片）",
    "光电门",
    "数字计时器",
    "游标卡尺",
    "刻度尺",
    "铅垂线",
    "天平",
    "挡板或软垫"
  ],
  "steps": [
    "把轨道一端用垫块垫高，使轨道倾斜并固定好；光电门固定在轨道下部，接好数字计时器。最好量出并记下轨道的倾角。",
    "用游标卡尺测遮光片的宽度 d，用天平测小车的质量 m。",
    "把小车放在轨道上某一位置，用铅垂线和刻度尺量出释放点到光电门处的竖直高度差 h（两处都量小车上同一个点，例如遮光片中心）。",
    "让小车从该位置由静止释放，手不要推小车，记下遮光片的挡光时间 Δt，算出 v = d/Δt。",
    "改变释放位置，使 h 约为 5 cm、10 cm、15 cm、20 cm、25 cm，重复步骤 3、4。",
    "算出每次的 gh 和 ½v²，以 gh 为横轴、½v² 为纵轴作图，看图线是否过原点、斜率是否为 1；也可以直接比较 mgh 和 ½mv²。"
  ],
  "data_table": {
    "columns": [
