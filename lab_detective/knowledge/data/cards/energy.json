      "下落高度 h/cm",
      "挡光时间 Δt/ms",
      "速度 v/(m·s⁻¹)",
      "gh/(J·kg⁻¹)",
      "½v²/(J·kg⁻¹)"
    ]
  },
  "safety": [
    "轨道末端放挡板或软垫，防止小车冲出轨道摔落。",
    "垫高轨道时把垫块和轨道放稳，防止轨道滑落砸到手脚。",
    "小车运动时不要用手在轨道上去接，等它停稳再取。"
  ],
