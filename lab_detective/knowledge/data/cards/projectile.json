    "projectile.height_wrong": ["kp.free_fall", "kp.scale_reading", "kp.systematic_error"],
    "projectile.end_tilted": ["kp.projectile_motion", "kp.motion_composition", "kp.ideal_model"],
    "projectile.slipping": ["kp.static_friction", "kp.kinetic_energy", "kp.ideal_model"],
    "projectile.landing_scatter": ["kp.random_error", "kp.multiple_measurements"],
